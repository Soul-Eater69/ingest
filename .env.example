# =============================================================================
# Codebase Indexer – Example Environment Configuration
# =============================================================================
# Copy this file to .env and edit it:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
CIDX_LOG_LEVEL=INFO
CIDX_DEBUG=false

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
CIDX_API_HOST=0.0.0.0
CIDX_API_PORT=8000
CIDX_API_WORKERS=1

# Uncomment to enable API key authentication:
# CIDX_API_KEY=change-me-to-a-strong-random-key

# ---------------------------------------------------------------------------
# Embedding Provider
# ---------------------------------------------------------------------------
# Option A: Local (free, private, no API key needed) – DEFAULT
CIDX_EMBED_PROVIDER=sentence_transformers
CIDX_ST_MODEL_NAME=BAAI/bge-base-en-v1.5
CIDX_ST_DEVICE=cpu           # or "cuda" or "mps" for GPU
CIDX_ST_BATCH_SIZE=64

# Option B: OpenAI (better quality, costs money)
# CIDX_EMBED_PROVIDER=openai
# CIDX_OPENAI_API_KEY=sk-your-key-here
# CIDX_OPENAI_EMBED_MODEL=text-embedding-3-small

# Embedding cache (saves recomputing on re-index)
CIDX_EMBED_CACHE_ENABLED=true
CIDX_EMBED_CACHE_DIR=.cidx_cache/embeddings

# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------
# Option A: ChromaDB (embedded, no server needed) – DEFAULT
CIDX_VECTOR_BACKEND=chroma
CIDX_CHROMA_PATH=.cidx_data/chroma
CIDX_CHROMA_COLLECTION=codebase

# Option B: Qdrant (production-grade, requires running server)
# CIDX_VECTOR_BACKEND=qdrant
# CIDX_QDRANT_URL=http://localhost:6333
# CIDX_QDRANT_API_KEY=   # for Qdrant Cloud
# CIDX_QDRANT_COLLECTION=codebase

# ---------------------------------------------------------------------------
# Metadata Store
# ---------------------------------------------------------------------------
# SQLite (default, embedded, zero config)
CIDX_METADATA_DB_URL=sqlite:///.cidx_data/metadata.db

# PostgreSQL (for production multi-worker deployments)
# CIDX_METADATA_DB_URL=postgresql://cidx:password@localhost:5432/cidx

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CIDX_CHUNK_STRATEGY=hybrid          # semantic | sliding | hybrid
CIDX_CHUNK_SIZE=512                  # approximate tokens per chunk
CIDX_CHUNK_OVERLAP=64               # token overlap between adjacent chunks
CIDX_MAX_SYMBOL_TOKENS=1024         # max symbol size before splitting

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
CIDX_DEFAULT_SEARCH_MODE=hybrid
CIDX_RETRIEVAL_TOP_K=20             # candidates from ANN before filtering
CIDX_RESULTS_TOP_N=10               # final results returned to user

# Cross-encoder re-ranking (improves quality, adds latency ~50ms on CPU)
CIDX_RERANKER_ENABLED=false
CIDX_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
CIDX_MAX_FILE_BYTES=5242880         # 5 MB max file size
CIDX_INGEST_CONCURRENCY=8
CIDX_RESPECT_GITIGNORE=true
CIDX_STORE_GIT_BLAME=false          # set true to store author/commit metadata

# ---------------------------------------------------------------------------
# File Watcher (for cidx watch)
# ---------------------------------------------------------------------------
CIDX_WATCH_DEBOUNCE_SECONDS=2.0
